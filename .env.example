# ==============================================================================
# Sehat Saathi Environment Variables Configuration
# ==============================================================================

# Google Gemini API Key
# Required for server-side clinical search grounding, healthcare chatbot,
# audio transcription, and Gemini Live bidirectional voice WebSocket.
# Obtain key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Server Port
# Defaults to 3000 locally. On Render, the $PORT environment variable is automatically
# injected (e.g. 10000) and handled by server.ts.
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=production
